# Cinema Machine — Replit deployment config (Static Deployment).
# The deploy build (scripts/build-dist.mjs) transpiles + minifies every app/*.jsx
# into dist/app/*.js and rewrites TURN.html → dist/index.html with plain <script>
# tags (no Babel). So PROD ships transpiled/minified code (comments stripped, no
# in-browser Babel = near-instant boot); DEV stays buildless (raw .jsx via Babel
# standalone). docs/, supabase/ and the rest of the repo stay unpublished.

# local preview inside the Replit workspace (optional)
run = "python3 -m http.server 8099"
modules = ["nodejs-24"]

[deployment]
deploymentTarget = "static"
publicDir = "dist"
build = ["sh", "-c", "npm install && npm run build"]

[[ports]]
localPort = 5000
externalPort = 5000

[[ports]]
localPort = 8099
externalPort = 80

[agent]
expertMode = true

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[workflows.workflow.metadata]
outputType = "webview"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "node serve.js"
waitForPort = 5000

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 120000
