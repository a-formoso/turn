# Cinema Machine — Replit deployment config (Static Deployment).
# The "build" just assembles dist/: TURN.html served as index.html + the app/
# folder. No bundler — the app compiles JSX in the browser (Babel standalone).
# docs/, supabase/ and the rest of the repo stay unpublished.

# local preview inside the Replit workspace (optional)
run = "python3 -m http.server 8099"
modules = ["nodejs-24"]

[deployment]
deploymentTarget = "static"
publicDir = "dist"
build = ["sh", "-c", "mkdir -p dist && cp TURN.html dist/index.html && cp -r app dist/app"]

[[ports]]
localPort = 5000
externalPort = 5000

[[ports]]
localPort = 8099
externalPort = 80

[agent]
expertMode = true

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[workflows.workflow.metadata]
outputType = "webview"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "node serve.js"
waitForPort = 5000
